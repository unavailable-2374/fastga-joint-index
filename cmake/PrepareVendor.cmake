# Verify every pinned input; prepare patched copies without touching vendor/.
find_program(SJ_PATCH_EXECUTABLE patch REQUIRED)
set(_signature "")
foreach(_name libsais nlohmann-json fastga bigbwt)
  if(_name STREQUAL "libsais")
    set(_manifest "${PROJECT_SOURCE_DIR}/vendor/${_name}/PROVENANCE.json")
  else()
    set(_manifest "${PROJECT_SOURCE_DIR}/vendor/${_name}/UPSTREAM.json")
  endif()
  file(READ "${_manifest}" _json)
  file(SHA256 "${_manifest}" _hash)
  string(APPEND _signature "${_hash}")
  string(JSON _count LENGTH "${_json}" files)
  math(EXPR _last "${_count}-1")
  foreach(_i RANGE ${_last})
    string(JSON _file MEMBER "${_json}" files ${_i})
    string(JSON _expected GET "${_json}" files "${_file}")
    set(_source "${PROJECT_SOURCE_DIR}/vendor/${_name}/${_file}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}" "${_manifest}")
    if(NOT EXISTS "${_source}")
      message(FATAL_ERROR "vendored source missing: ${_name}/${_file}")
    endif()
    file(SHA256 "${_source}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "vendored source checksum mismatch: ${_name}/${_file}")
    endif()
  endforeach()
endforeach()
foreach(_name fastga bigbwt)
  set(_patch "${PROJECT_SOURCE_DIR}/patches/${_name}.patch")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_patch}")
  file(SHA256 "${_patch}" _hash)
  string(APPEND _signature "${_hash}")
endforeach()
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _hash)
string(SHA256 _signature "${_signature}${_hash}")
set(_stamp "${CMAKE_BINARY_DIR}/upstream/prepared.json")
set(_reuse FALSE)
if(EXISTS "${_stamp}")
  file(READ "${_stamp}" _prepared)
  string(JSON _previous ERROR_VARIABLE _error GET "${_prepared}" signature)
  if(NOT _error AND _previous STREQUAL _signature)
    set(_reuse TRUE)
    string(JSON _count LENGTH "${_prepared}" files)
    math(EXPR _last "${_count}-1")
    foreach(_i RANGE ${_last})
      string(JSON _file MEMBER "${_prepared}" files ${_i})
      string(JSON _expected GET "${_prepared}" files "${_file}")
      if(NOT EXISTS "${CMAKE_BINARY_DIR}/upstream/${_file}")
        set(_reuse FALSE)
      else()
        file(SHA256 "${CMAKE_BINARY_DIR}/upstream/${_file}" _actual)
        if(NOT _actual STREQUAL _expected)
          set(_reuse FALSE)
        endif()
      endif()
    endforeach()
  endif()
endif()
if(NOT _reuse)
  set(_prepared "{\"signature\":\"${_signature}\",\"files\":{}}")
  foreach(_name fastga bigbwt)
    file(READ "${PROJECT_SOURCE_DIR}/vendor/${_name}/UPSTREAM.json" _json)
    string(JSON _count LENGTH "${_json}" files)
    math(EXPR _last "${_count}-1")
    set(_output "${CMAKE_BINARY_DIR}/upstream/${_name}")
    foreach(_i RANGE ${_last})
      string(JSON _file MEMBER "${_json}" files ${_i})
      configure_file("${PROJECT_SOURCE_DIR}/vendor/${_name}/${_file}" "${_output}/${_file}" COPYONLY)
    endforeach()
    execute_process(COMMAND "${SJ_PATCH_EXECUTABLE}" --batch --forward -p1 -i "${PROJECT_SOURCE_DIR}/patches/${_name}.patch"
      WORKING_DIRECTORY "${_output}" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    if(NOT _status EQUAL 0)
      message(FATAL_ERROR "Program patch failed with: ${_stderr}${_stdout}")
    endif()
    foreach(_i RANGE ${_last})
      string(JSON _file MEMBER "${_json}" files ${_i})
      file(SHA256 "${_output}/${_file}" _actual)
      if(_name STREQUAL "fastga")
        string(JSON _expected ERROR_VARIABLE _missing GET "${_json}" patched_files "${_file}")
        if(NOT _missing AND NOT _actual STREQUAL _expected)
          message(FATAL_ERROR "patched FastGA differs from the validated source: ${_file}")
        endif()
      endif()
      string(JSON _prepared SET "${_prepared}" files "${_name}/${_file}" "\"${_actual}\"")
    endforeach()
  endforeach()
  file(WRITE "${_stamp}" "${_prepared}\n")
endif()
string(JSON _count LENGTH "${_prepared}" files)
math(EXPR _last "${_count}-1")
foreach(_i RANGE ${_last})
  string(JSON _file MEMBER "${_prepared}" files ${_i})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_BINARY_DIR}/upstream/${_file}")
endforeach()
message(STATUS "Verified pinned sources and build-local patches (reused=${_reuse}).")
