+//  Load, sort and cut into units the parts in order, keeping at most the memory budget of sorted
+//  parts (but always at least two) ahead of the searchers.
+
+static void *produce_parts(void *args)
+{ Sched    *sch   = (Sched *) args;
+  RP       *rarm  = sch->rarm;
+  int       swide = sch->swide;
+  IOBuffer *unit[2];
+  pthread_t *threads;
+  int64     *panel;
+  int        q, p, j;
+
+  unit[0] = N_Units;
+  unit[1] = C_Units;
+
+  threads = (pthread_t *) Malloc(sizeof(pthread_t)*NTHREADS,"Allocating producer threads");
+  panel   = (int64 *) Malloc(sizeof(int64)*NCONTS,"Bucket Array");
+  if (threads == NULL || panel == NULL)
+    Clean_Exit(1);
+
+  for (q = 0; q < sch->nparts; q++)
+    { int       u = q / NPARTS;
+      int       i = q % NPARTS;
+      IOBuffer *nu = unit[u] + i*NTHREADS;
+      int64     nels = sch->pnels[q];
+      int64     need = (nels+1)*swide;
+      uint8    *sarray;
+      Job      *job;
+      int64     prev, next;
+      uint8    *x, *e, *b;
+      int       nmax;
+      int       icrnt;
+      int64     jcrnt;
+      uint8    *_jcrnt = (uint8 *) (&jcrnt);
+      int       foffs = swide-JCONT;
+#ifdef UNIT_STATS
+      double    t0, t1, t2;
+#endif
+
+      pthread_mutex_lock(&sch->lock);
+      while (sch->nlive >= 1 && sch->live_bytes + need > sch->limit)
+        pthread_cond_wait(&sch->room,&sch->lock);
+      sch->nlive += 1;
+      sch->live_bytes += need;
+      pthread_mutex_unlock(&sch->lock);
+      gate_acquire(1);                     //  for the serial steps of this part
+      contig_trim(need);
+
+      sarray = (uint8 *) Malloc(need,"Sort Array");
+      job    = (Job *) Malloc(sizeof(Job),"Search job");
+      if (sarray == NULL || job == NULL)
+        Clean_Exit(1);
+#ifdef MADV_HUGEPAGE
+      if (need >= (64ll<<20) && getenv("SXGC_HUGEPAGE") != NULL)
+        //  Opt-in: huge pages for the sort array cut the search phase by about a quarter on large
+        //  parts, but a fault may stall in direct compaction on a fragmented host (seen once as
+        //  14 min of system time over 24 threads), so it is not the default.
+        { uintptr_t lo = ((uintptr_t) sarray + 4095) & ~((uintptr_t) 4095);
+          uintptr_t hi = ((uintptr_t) sarray + need) & ~((uintptr_t) 4095);
+
+          if (hi > lo)
+            madvise((void *) lo,hi-lo,MADV_HUGEPAGE);
+        }
+#endif
+
+#ifdef UNIT_STATS
+      t0 = wall_now();
+#endif
+      for (p = 0; p < NTHREADS; p++)
+        { rarm[p].sarr = sarray;
+          rarm[p].in   = nu[p].file;
+          lseek(nu[p].file,0,SEEK_SET);
+          rarm[p].buck = nu[p].buck;
+          rarm[p].comp = u;
+          rarm[p].inum = nu[p].inum;
+        }
+      gate_release();                      //  each reimport thread takes its own token
+      for (p = 1; p < NTHREADS; p++)
+        Spawn(threads+p,reimport_gated,rarm+p);
+      reimport_gated(rarm);
+      for (p = 1; p < NTHREADS; p++)
+        pthread_join(threads[p],NULL);
+      gate_acquire(1);
+
+      bzero(panel,sizeof(int64)*NCONTS);
+      prev = 0;
+      next = 0;
+      for (j = IDBsplit[i]; j < IDBsplit[i+1]; j++)
+        { next = nu[NTHREADS-1].buck[j];
+          panel[j] = (next - prev)*swide;
+          prev = next;
+        }
+      if (next != nels)
+        { fprintf(stderr,"%s: Seed count mismatch in part %d (%lld vs %lld)\n",
+                         Prog_Name,q+1,next,nels);
+          Clean_Exit(1);
+        }
+
+#ifdef UNIT_STATS
+      t1 = wall_now();
+#endif
+      gate_release();                      //  rmsd_sort takes a token per sort task
+      if (rmsd_sort(sarray,nels,swide,swide,NCONTS,panel,NTHREADS))
+        { fprintf(stderr,"%s: Out of memory sorting seeds of part %d\n",Prog_Name,q+1);
+          Clean_Exit(1);
+        }
+      gate_acquire(1);
+#ifdef UNIT_STATS
+      t2 = wall_now();
+#endif
+
+      //  Cut the sorted part into (A contig, B contig) units, in block order
+
+      cut_part(job,sarray,panel,IDBsplit[i],IDBsplit[i+1],swide);
+      job->released = 0;
+      block_order(job);
+
+      job->q     = q;
+      job->comp  = u;
+      job->sarr  = sarray;
+      job->next  = 0;
+      job->done  = 0;
+      job->bytes = need;
+
+#ifdef UNIT_STATS
+      PS[q].q = q;  PS[q].nels = nels;
+      PS[q].treimport = t1-t0;  PS[q].tsort = t2-t1;  PS[q].tready = wall_now();
+#endif
+
+      pthread_mutex_lock(&sch->lock);
+      if (job->nunit == 0)
+        { sch->nlive -= 1;
+          sch->live_bytes -= need;
+          sch->pdone += 1;
+          free(sarray);
+          free(job->unit);
+          free(job->bleft);
+          free(job->bbeg);
+          free(job);
+        }
+      else
+        sch->job[sch->njob++] = job;
+      pthread_cond_broadcast(&sch->work);
+      pthread_mutex_unlock(&sch->lock);
+      gate_release();
+    }
+
+  free(panel);
+  free(threads);
+
+  pthread_mutex_lock(&sch->lock);
+  sch->finished = 1;
+  pthread_cond_broadcast(&sch->work);
+  pthread_mutex_unlock(&sch->lock);
+
+  return (NULL);
+}
