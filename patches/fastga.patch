+static char *cc_new_block(int64 size)
+{ if (size < CC_MAP_MIN)
+    return ((char *) malloc(size));
+  { void *m = mmap(NULL,size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+
+    return (m == MAP_FAILED ? NULL : (char *) m);
+  }
+}
+
+static void cc_free_block(char *base, int64 size)
+{ if (size < CC_MAP_MIN)
+    free(base);
+  else
+    munmap(base,size);
+}
+
+//  Give a block that is to be reused another size, keeping its pages as far as they reach.
+
+#ifndef MREMAP_MAYMOVE
+#define MREMAP_MAYMOVE 1
+extern void *mremap(void *old, size_t olen, size_t nlen, int flags, ...);
+#endif
+
+static char *cc_resize_block(char *base, int64 size, int64 nsize)
+{ char *n;
+
+  if (nsize == size)
+    return (base);
+  if (size >= CC_MAP_MIN && nsize >= CC_MAP_MIN)
+    { void *m = mremap(base,size,nsize,MREMAP_MAYMOVE);
+
+      return (m == MAP_FAILED ? NULL : (char *) m);
+    }
+  if (size < CC_MAP_MIN && nsize < CC_MAP_MIN)
+    return ((char *) realloc(base,nsize));
+  n = cc_new_block(nsize);
+  if (n != NULL)
+    cc_free_block(base,size);
+  return (n);
+}
+
+//  Released contigs are kept in memory the process has already used: their allowance is what
+//  they occupy now plus the distance of the resident set to a reference peak (less a margin for
+//  the other allocations of the threads), and at least CONTIG_CACHE_BYTES.  The reference is the
+//  peak RSS of the earlier phases or, when the search goes beyond it, the peak of the resident
+//  set less the blocks of the cache, so that the cache never sets the reference itself (a
+//  reference that included it would ratchet up with every transient allocation on top of a full
+//  cache).  The cache therefore does not raise the peak RSS, which the seed merge or the sorted
+//  parts set, beyond the referenced contigs and CONTIG_CACHE_BYTES, and keeps as many released
+//  contigs as the memory below that peak holds (on maize Mo17 against B73 the seed merge peaks
+//  1.5 GB above the search phase, enough to keep most of the B genome decoded).  extra is memory
+//  about to be taken by the caller.
+
+#define CC_MARGIN  (128ll<<20)
+
+static int64 cc_rss(void)
+{ static int64 page = 0;
+  long long    size, res;
+  FILE        *f;
+
+  if (page == 0)
+    page = sysconf(_SC_PAGESIZE);
+  f = fopen("/proc/self/statm","r");
+  if (f == NULL)
+    return (-1);
+  if (fscanf(f,"%lld %lld",&size,&res) != 2)
+    res = -1;
+  fclose(f);
+  return (res < 0 ? -1 : res*page);
+}
+
+//  CC_room, the distance to the peak, is measured at most every CC_REFRESH ns and follows the
+//  blocks the cache allocates and frees in between.
+
+#define CC_REFRESH  (10000000ll)
+
+static int64 CC_room, CC_room_t, CC_peak;
+
+static void cc_refresh(int force)
+{ struct timespec t;
+  int64           now, rss, nc, pk;
+
+  if (!CC_track)
+    return;
+  clock_gettime(CLOCK_MONOTONIC_COARSE,&t);
+  now = t.tv_sec*1000000000ll + t.tv_nsec;
+  if (!force && now - __atomic_load_n(&CC_room_t,__ATOMIC_RELAXED) < CC_REFRESH)
+    return;
+  __atomic_store_n(&CC_room_t,now,__ATOMIC_RELAXED);
+  rss = cc_rss();
+  if (rss < 0)
+    return;
+  nc = rss - __atomic_load_n(&CC_bytes,__ATOMIC_RELAXED);
+  pk = __atomic_load_n(&CC_peak,__ATOMIC_RELAXED);
+  while (nc > pk && !__atomic_compare_exchange_n(&CC_peak,&pk,nc,0,__ATOMIC_RELAXED,__ATOMIC_RELAXED))
+    ;
+  if (nc > pk)
+    pk = nc;
+  __atomic_store_n(&CC_room,pk - rss - CC_MARGIN,__ATOMIC_RELAXED);
+}
+
+//  Start following the peak: the peak of the earlier phases is the first reference.
+
+static void cc_track_start(void)
+{ struct rusage r;
+
+  CC_peak   = (getrusage(RUSAGE_SELF,&r) == 0 ? 1024ll*r.ru_maxrss : 0);
+  CC_room   = 0;
+  CC_room_t = 0;
+  CC_track  = 1;
+  cc_refresh(1);
+}
+
+static int64 cc_allow(int64 extra)    //  CC_lock held
+{ int64 a = 0;
+
+  if (CC_track)
+    a = CC_idle + __atomic_load_n(&CC_room,__ATOMIC_RELAXED) - extra;
+  return (a > CONTIG_CACHE_BYTES ? a : CONTIG_CACHE_BYTES);
+}
+
+//  Unlink released entries, least recently used first, until at most allow bytes of released
+//  blocks remain, or until room bytes more are free when room > 0 (CC_lock held).  The entries
+//  are put in *out (to be freed by cc_free_list after the lock is released).
+
+typedef struct { CEntry **e; int n, cap; } CList;
+
+static void cc_evict(int64 allow, CList *out)
+{ while (CC_idle > allow)
+    { int best = -1, i;
+
+      for (i = 0; i < CC_n; i++)
+        if (CC_ent[i]->refs == 0 && CC_ent[i]->ready)
+          if (best < 0 || CC_ent[i]->stamp < CC_ent[best]->stamp)
+            best = i;
+      if (best < 0)
+        break;
+      if (out->n >= out->cap)
+        { out->cap = 2*out->cap + 16;
+          out->e   = (CEntry **) realloc(out->e,sizeof(CEntry *)*out->cap);
+          if (out->e == NULL)
+            { fprintf(stderr,"%s: Cannot allocate contig cache\n",Prog_Name);
+              Clean_Exit(1);
+            }
+        }
+      out->e[out->n++] = CC_ent[best];
+      CC_bytes -= CC_ent[best]->size;
+      CC_idle  -= CC_ent[best]->size;
+      CC_ent[best] = CC_ent[--CC_n];
+    }
+}
+
+static void cc_free_list(CList *l)
+{ int i;
+
+  for (i = 0; i < l->n; i++)
+    { __atomic_fetch_add(&CC_room,l->e[i]->size,__ATOMIC_RELAXED);
+      cc_free_block(l->e[i]->base,l->e[i]->size);
+      pthread_cond_destroy(&(l->e[i]->done));
+      free(l->e[i]);
+    }
+  free(l->e);
+}
+
+//  Free released contigs beyond the current allowance (the producer calls this when it takes
+//  memory for a new part).
+
+static void contig_trim(int64 extra)
+{ CList l = { NULL, 0, 0 };
+
+  cc_refresh(1);
+  pthread_mutex_lock(&CC_lock);
+  cc_evict(cc_allow(extra),&l);
+  pthread_mutex_unlock(&CC_lock);
+  cc_free_list(&l);
+}
+
+//  The 2-bit compressed sequence (read with pread from the .bps file, or in memory) is decoded
+//  straight into the block, four bases per byte through a table (with their reverse complement
+//  for the minus strand): one pass instead of the unpack into a buffer and the copy of
+//  Get_Contig_Piece, and the same bytes.
+
+static uint32         CC_tab[256], CC_rtab[256];
+static pthread_once_t CC_tab_once = PTHREAD_ONCE_INIT;
+
+static void cc_tab_init(void)
+{ int b, i;
+
+  for (b = 0; b < 256; b++)
+    { uint8 v[4], r[4];
+
+      for (i = 0; i < 4; i++)
+        v[i] = (uint8) ((b >> (2*i)) & 0x3);
+      for (i = 0; i < 4; i++)
+        r[i] = (uint8) (3 - v[3-i]);
+      memcpy(CC_tab+b,v,4);
+      memcpy(CC_rtab+b,r,4);
+    }
+}
+
+static __thread char  *CC_tmp;
+static __thread uint8 *CC_pak;
+
+static void cc_decode_chunk(CEntry *e, GDB *gdb, int c)
+{ int64 beg = c*e->chunk;
+  int64 end = beg + e->chunk;
+  int64 n, i;
+  char *tmp;
+
+  if (end > e->len)
+    end = e->len;
+  n = end - beg;
+  if (gdb->seqstate == COMPRESSED || (gdb->seqstate == EXTERNAL && gdb->seqs != NULL))
+    { int64  off = gdb->contigs[e->ctg].boff + beg/4;   //  beg % 4 == 0
+      int64  m   = n & ~3ll;
+      uint8 *p;
+
+      if (gdb->seqstate == COMPRESSED)
+        p = ((uint8 *) gdb->seqs) + off;
+      else
+        { int    fd  = fileno((FILE *) gdb->seqs);
+          int64  nb  = (n+3)/4;
+          int64  got = 0;
+
+          if (CC_pak == NULL)
+            { CC_pak = (uint8 *) malloc(CC_CHUNK_MAX/4+16);
+              if (CC_pak == NULL)
+                { fprintf(stderr,"%s: Cannot allocate contig decode buffer\n",Prog_Name);
+                  Clean_Exit(1);
+                }
+            }
+          while (got < nb)
+            { ssize_t r = pread(fd,CC_pak+got,nb-got,off+got);
+
+              if (r <= 0)
+                { fprintf(stderr,"%s: Failed read of GDB sequence file (contig cache)\n",Prog_Name);
+                  Clean_Exit(1);
+                }
+              got += r;
+            }
+          p = CC_pak;
+        }
+      pthread_once(&CC_tab_once,cc_tab_init);
+      if (e->comp)
+        { char *d = e->seq + (e->len - beg);   //  base beg+i goes to d[-1-i]
+
+          for (i = 0; i < m; i += 4)
+            memcpy(d-i-4,CC_rtab+p[i>>2],4);
+          for ( ; i < n; i++)
+            d[-1-i] = (char) (3 - ((p[i>>2] >> (2*(i&3))) & 0x3));
+        }
+      else
+        { char *d = e->seq + beg;
+
+          for (i = 0; i < m; i += 4)
+            memcpy(d+i,CC_tab+p[i>>2],4);
+          for ( ; i < n; i++)
+            d[i] = (char) ((p[i>>2] >> (2*(i&3))) & 0x3);
+        }
+      return;
+    }
+  if (CC_tmp == NULL)
+    { CC_tmp = (char *) malloc(CC_CHUNK_MAX+16);
+      if (CC_tmp == NULL)
+        { fprintf(stderr,"%s: Cannot allocate contig decode buffer\n",Prog_Name);
+          Clean_Exit(1);
+        }
+    }
+  tmp = CC_tmp + 1;
+  if (Get_Contig_Piece(gdb,e->ctg,(int) beg,(int) end,NUMERIC,tmp) == NULL)
+    Clean_Exit(1);
+  if (e->comp)
+    { char *d = e->seq + (e->len - end);
+
+      for (i = 0; i < n; i++)
+        d[i] = (char) (3 - tmp[n-1-i]);
+    }
+  else
+    memcpy(e->seq+beg,tmp,n);
+}
+
+//  Called with CC_lock held; returns with it held once the entry is ready.
+
+static void cc_help(CEntry *e, GDB *gdb)
+{ while (!e->ready)
+    { if (e->armed && __atomic_load_n(&e->nextc,__ATOMIC_RELAXED) < e->nchunk)
+        { int c, last = 0;
+
+          pthread_mutex_unlock(&CC_lock);
+          while ((c = __atomic_fetch_add(&e->nextc,1,__ATOMIC_RELAXED)) < e->nchunk)
+            { cc_decode_chunk(e,gdb,c);
+              if (__atomic_add_fetch(&e->donec,1,__ATOMIC_ACQ_REL) == e->nchunk)
+                last = 1;
+            }
+          pthread_mutex_lock(&CC_lock);
+          if (last)
+            { e->ready = 1;
+              pthread_cond_broadcast(&e->done);
+            }
+        }
+      else
+        pthread_cond_wait(&e->done,&CC_lock);
+    }
+}
+
+static CEntry *contig_acquire(GDB *gdb, int g, int ctg, int comp)
+{ CEntry *e;
+  int     i, best;
+  int64   len   = gdb->contigs[ctg].clen;
+  int64   need  = cc_class(len + CONTIG_TAIL + 16);
+  CList   vict  = { NULL, 0, 0 };
+  int64   oldsize;
+
+  cc_refresh(0);
+  pthread_mutex_lock(&CC_lock);
+  for (i = 0; i < CC_n; i++)
+    { e = CC_ent[i];
+      if (e->g == g && e->ctg == ctg && e->comp == comp)
+        { if (e->refs++ == 0)
+            CC_idle -= e->size;
+          e->stamp = ++CC_clock;
+          cc_help(e,gdb);
+          pthread_mutex_unlock(&CC_lock);
+          return (e);
+        }
+    }
+
+  //  Reuse the least recently used released block of the right size, or, when released
+  //  contigs would have to be freed for a new block anyway, the least recently used released
+  //  block resized.
+
+  oldsize = 0;
+  best    = -1;
+  for (i = 0; i < CC_n; i++)
+    { CEntry *c = CC_ent[i];
+
+      if (c->refs == 0 && c->ready && c->size == need)
+        if (best < 0 || c->stamp < CC_ent[best]->stamp)
+          best = i;
+    }
+  if (best < 0 && CC_idle + need > cc_allow(0))
+    for (i = 0; i < CC_n; i++)
+      { CEntry *c = CC_ent[i];
+
+        if (c->refs == 0 && c->ready)
+          if (best < 0 || c->stamp < CC_ent[best]->stamp)
+            best = i;
+      }
+  if (best >= 0)
+    { e = CC_ent[best];
+      CC_idle  -= e->size;
+      oldsize   = e->size;
+      CC_bytes += need - e->size;
+      e->size   = need;
+      __atomic_fetch_sub(&CC_room,need - oldsize,__ATOMIC_RELAXED);
+      e->refs   = 1;
+      e->ready  = 0;
+      cc_evict(cc_allow(0),&vict);
+    }
+  else
+    { cc_evict(cc_allow(need),&vict);
+      if (CC_n >= CC_cap)
+        { CC_cap = 2*CC_cap + 64;
+          CC_ent = (CEntry **) realloc(CC_ent,sizeof(CEntry *)*CC_cap);
+          if (CC_ent == NULL)
+            { fprintf(stderr,"%s: Cannot allocate contig cache\n",Prog_Name);
+              Clean_Exit(1);
+            }
+        }
+      e = (CEntry *) malloc(sizeof(CEntry));
+      if (e == NULL)
+        { fprintf(stderr,"%s: Cannot allocate contig cache entry\n",Prog_Name);
+          Clean_Exit(1);
+        }
+      pthread_cond_init(&e->done,NULL);
+      e->size = need;
+      e->base = NULL;
+      CC_ent[CC_n++] = e;
+      CC_bytes += e->size;
+      __atomic_fetch_sub(&CC_room,e->size,__ATOMIC_RELAXED);
+    }
+  e->g     = g;
+  e->ctg   = ctg;
+  e->comp  = comp;
+  e->refs  = 1;
+  e->ready = 0;
+  e->armed = 0;
+  e->stamp = ++CC_clock;
+  pthread_mutex_unlock(&CC_lock);
+
+  cc_free_list(&vict);
+  if (oldsize > 0 && oldsize != e->size)
+    { e->base = cc_resize_block(e->base,oldsize,e->size);
+      if (e->base == NULL)
+        { fprintf(stderr,"%s: Cannot resize contig buffer\n",Prog_Name);
+          Clean_Exit(1);
+        }
+    }
+  if (e->base == NULL)
+    { e->base = cc_new_block(e->size);
+      if (e->base == NULL)
+        { fprintf(stderr,"%s: Cannot allocate contig buffer\n",Prog_Name);
+          Clean_Exit(1);
+        }
+    }
+
+  //  The sequence area is overwritten by the chunks; the byte before it and the CONTIG_TAIL+15
+  //  bytes after it are the end-of-sequence code, as they are in a block that was filled
+  //  completely before decoding.
+
+  e->seq     = e->base + 1;
+  e->base[0] = 4;
+  memset(e->seq+len,4,CONTIG_TAIL+15);
+  e->len    = len;
+  e->chunk  = ((len / NTHREADS + 3) / 4) * 4;
+  if (e->chunk < CC_CHUNK_MIN)
+    e->chunk = CC_CHUNK_MIN;
+  if (e->chunk > CC_CHUNK_MAX)
+    e->chunk = CC_CHUNK_MAX;
+  e->nchunk = (int) ((len + e->chunk - 1) / e->chunk);
+  e->nextc  = 0;
+  e->donec  = 0;
+
+  pthread_mutex_lock(&CC_lock);
+  if (e->nchunk == 0)
+    e->ready = 1;
+  e->armed = 1;
+  pthread_cond_broadcast(&e->done);
+  cc_help(e,gdb);
+  pthread_mutex_unlock(&CC_lock);
+  return (e);
+}
+
+static void contig_release(CEntry *e)
+{ pthread_mutex_lock(&CC_lock);
+  if (--e->refs == 0)
+    CC_idle += e->size;
+  pthread_mutex_unlock(&CC_lock);
+}
+
+static void contig_cache_free(void)
+{ int i;
+
+  for (i = 0; i < CC_n; i++)
+    { cc_free_block(CC_ent[i]->base,CC_ent[i]->size);
+      pthread_cond_destroy(&(CC_ent[i]->done));
+      free(CC_ent[i]);
+    }
+  free(CC_ent);
+  CC_ent = NULL;
+  CC_n = CC_cap = 0;
+  CC_bytes = CC_idle = 0;
+}
