+/* Packed overlap records have byte-sized traces between headers. Their next
+   header need not satisfy _Alignof(Overlap), so decode into aligned objects,
+   just as Read_Overlap does, rather than casting the serialized byte stream. */
+static void unpack_overlap_header(Overlap *out, const void *packed, int full)
+{ if (full) memcpy(out,packed,OVL_SIZE);
+  else memcpy(((char *)out)+PTR_SIZE,packed,EXO_SIZE);
+  out->path.trace = ((char *)packed) + (full ? OVL_SIZE : EXO_SIZE);
+}
