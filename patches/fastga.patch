+#ifdef SXGC_SHARED_GIX
+/* Self matching chooses the longest prefix of a different occurrence.
+   Repeated exact keys use KMER; singleton keys use their nearest LCP neighbors.
+   Frequency includes the query itself, exactly as in the native cache merge. */
+static void *joint_self_merge_thread(void *args)
+{ SP *parm = (SP *)args;
+  Kmer_Stream *stream = parm->T1;
+  IOBuffer *normal = parm->nunit, *inverse = parm->cunit;
+  uint8 *records = Malloc((size_t)FREQ*stream->pbyte,"Allocating lazy self occurrences");
+  int begin = parm->tid ? ((parm->pbeg<<8)|0xff)+1 : 0;
+  int end = ((parm->pend<<8)|0xff)+1;
+  int p, j;
+  int64 nhits = 0, tseed = 0;
+  if (records == NULL) Clean_Exit(1);
+  for (j = 0; j < NPARTS; j++)
+    { normal[j].bend = normal[j].bufr + (1000000-(IBYTE+JBYTE+1));
+      normal[j].btop = normal[j].bufr;
+      inverse[j].bend = inverse[j].bufr + (1000000-(IBYTE+JBYTE+1));
+      inverse[j].btop = inverse[j].bufr;
+    }
+  for (p = begin; p < end; p++)
+    { uint8 *groups, *g;
+      int64 count;
+      if (stream->index[p] == (p ? stream->index[p-1] : 0)) continue;
+      count = sxgc_joint_prefix(stream,p,&groups);
+      for (g = groups; g < groups+count*SXGC_COMPACT_BYTES; g += SXGC_COMPACT_BYTES)
+        { uint64_t qn = sxgc_joint_count(g,g+SXGC_COMPACT_BYTES), n, row, q, t, qoffset;
+          int length = KMER, threshold;
+          uint8 *low = g, *high = g+SXGC_COMPACT_BYTES;
+          if (qn == 1)
+            { length = g[LBYTE] > high[LBYTE] ? g[LBYTE] : high[LBYTE];
+              if (length < 12) continue;
+              while (low > groups && low[LBYTE] >= length)
+                { low -= SXGC_COMPACT_BYTES;
+                  if (sxgc_joint_count(low,high) >= (uint64_t)FREQ) break;
+                }
+              while (high < groups+count*SXGC_COMPACT_BYTES && high[LBYTE] >= length)
+                { high += SXGC_COMPACT_BYTES;
+                  if (sxgc_joint_count(low,high) >= (uint64_t)FREQ) break;
+                }
+            }
+          n = sxgc_joint_count(low,high);
+          if (n >= (uint64_t)FREQ) continue;
+          row = sxgc_joint_row(low); qoffset = sxgc_joint_row(g)-row;
+          if (qoffset+qn > n) Clean_Exit(1);
+          threshold = SOFT_MASK ? length : KMER+1;
+          for (q = 0; q < n; q++) sxgc_joint_fetch(stream,row+q,records+q*stream->pbyte);
+          for (q = qoffset; q < qoffset+qn; q++)
+            { uint8 *query = records+q*stream->pbyte, *pay = query+PAYOFF;
+              int sign, destination;
+              uint64_t contig = 0;
+              if (query[CBYTE] >= threshold) continue;
+              sign = pay[ISIGN]&0x80; pay[ISIGN] &= 0x7f;
+              memcpy(&contig,pay+IPOST,ICONT); destination = Select[contig];
+              for (t = 0; t < n; t++)
+                { uint8 *target = records+t*stream->pbyte, *post = target+PAYOFF, *out;
+                  int target_sign;
+                  IOBuffer *unit;
+                  if (q == t || target[CBYTE] >= threshold) continue;
+                  target_sign = post[JSIGN]&0x80;
+                  unit = (sign == target_sign ? normal : inverse)+destination;
+                  out = unit->btop; *out++ = length;
+                  memcpy(out,pay,IBYTE); out += IBYTE;
+                  memcpy(out,post,JBYTE); out += JBYTE;
+                  unit->buck[contig]++; nhits++; tseed += length;
+                  if (out >= unit->bend)
+                    { if (write(unit->file,unit->bufr,out-unit->bufr) < 0) Clean_Exit(1);
+                      unit->btop = unit->bufr;
+                    }
+                  else unit->btop = out;
+                }
+              if (sign) pay[ISIGN] |= 0x80;
+            }
+        }
+    }
+  for (j = 0; j < NPARTS; j++)
+    { if (normal[j].btop > normal[j].bufr && write(normal[j].file,normal[j].bufr,normal[j].btop-normal[j].bufr) < 0) Clean_Exit(1);
+      if (inverse[j].btop > inverse[j].bufr && write(inverse[j].file,inverse[j].bufr,inverse[j].btop-inverse[j].bufr) < 0) Clean_Exit(1);
+    }
+  free(records); parm->nhits = nhits; parm->tseed = tseed; return NULL;
+}
+#endif
