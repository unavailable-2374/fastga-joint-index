+/* Union-LCP merge of two views of one joint bundle: the reader plans every T1 group's longest match and T2 range
+   from stored LCP codes and hands over native-shaped records, so no key is rebuilt. Pair emission is exactly that
+   of new_merge_thread (T1 rows outer, T2 rows inner, masks and strands tested per record). */
+static void *union_merge_thread(void *args)
+{ SP *parm = (SP *) args;
+  int flip         = parm->flip;
+  IOBuffer *nunit  = parm->nunit;
+  IOBuffer *cunit  = parm->cunit;
+  void     *worker = sxgc_union_worker(parm->plan);
+  Sxgc_Group grp;
+  int     mlen = KMER+1, plen, qcnt = -1, pcnt;
+  int64   nhits = 0, tseed = 0;
+  int64   acont = 0;
+  uint8  *aptr  = (uint8 *) (&acont);
+  uint64  r1;
+
+  { int j;
+
+    for (j = 0; j < NPARTS; j++)
+      { nunit[j].bend = nunit[j].bufr + (1000000-(IBYTE+JBYTE+1));
+        nunit[j].btop = nunit[j].bufr;
+        cunit[j].bend = cunit[j].bufr + (1000000-(IBYTE+JBYTE+1));
+        cunit[j].btop = cunit[j].bufr;
+      }
+  }
+
+  while (sxgc_union_next(worker,&grp))
+    { plen = grp.plen;
+      if (SOFT_MASK)
+        mlen = plen;
+
+      if (VERBOSE && parm->tid == 0)
+        { pcnt = sxgc_union_progress(worker);
+          if (pcnt > qcnt)
+            { fprintf(stderr,"\r    Completed %3d%%",pcnt);
+              fflush(stderr);
+            }
+          qcnt = pcnt;
+        }
+
+      for (r1 = 0; r1 < grp.n1; r1++)
+        { uint8 *suf1 = (uint8 *) grp.t1 + r1*grp.stride1;
+          uint8 *pair_high = (uint8 *) grp.t2 + grp.n2*grp.stride2;
+          uint8 *pair_low  = (uint8 *) grp.t2;
+          int    pair_stride = grp.stride2;
+
+          if (suf1[CBYTE] >= mlen)
+            continue;
+
+          if (flip)
+            { int       adest, bsign;
+              IOBuffer *ou;
+              uint8    *p, *pay1, *btop;
+
+              pay1 = suf1+PAYOFF;
+              bsign = (pay1[JSIGN] & 0x80);
+              for (p = pair_low+PAYOFF; p < pair_high; p += pair_stride)
+                { if (p[ISIGN] & 0x80 || p[-2] >= mlen)
+                    continue;
+                  memcpy(aptr,p+IPOST,ICONT);
+                  adest = Select[acont];
+                  if (bsign)
+                    ou = cunit + adest;
+                  else
+                    ou = nunit + adest;
+                  btop = ou->btop;
+                  *btop++ = plen;
+                  memcpy(btop,p,IBYTE);
+                  btop += IBYTE;
+                  memcpy(btop,pay1,JBYTE);
+                  btop += JBYTE;
+
+                  nhits += 1;
+                  tseed += plen;
+
+                  ou->buck[acont] += 1;
+
+                  if (btop >= ou->bend)
+                    { if (sj_write_all(ou->file,ou->bufr,btop-ou->bufr) < 0)
+                        { fprintf(stderr,"%s: IO write to file %s/%s.%d.%c failed: %s\n",
+                                         Prog_Name,SORT_PATH,PAIR_NAME,ou->inum,
+                                         bsign ? 'C' : 'N',strerror(errno));
+                          Clean_Exit(1);
+                        }
+                      ou->btop = ou->bufr;
+                    }
+                  else
+                    ou->btop = btop;
+                }
+            }
+
+          else
+
+            { int       asign, adest, bsign;
+              IOBuffer *ou;
+              uint8    *p, *pay1, *btop;
+
+              pay1  = suf1+PAYOFF;
+              asign = (pay1[ISIGN] & 0x80);
+              if (asign)
+                continue;
+              memcpy(aptr,pay1+IPOST,ICONT);
+
+              adest = Select[acont];
+
+              for (p = pair_low+PAYOFF; p < pair_high; p += pair_stride)
+                { if (p[-2] >= mlen)
+                    continue;
+                  bsign = (p[JSIGN] & 0x80);
+                  if (bsign)
+                    ou = cunit + adest;
+                  else
+                    ou = nunit + adest;
+                  btop = ou->btop;
+                  *btop++ = plen;
+                  memcpy(btop,pay1,IBYTE);
+                  btop += IBYTE;
+                  memcpy(btop,p,JBYTE);
+                  btop += JBYTE;
+
+                  nhits += 1;
+                  tseed += plen;
+
+                  ou->buck[acont] += 1;
+
+                  if (btop >= ou->bend)
+                    { if (sj_write_all(ou->file,ou->bufr,btop-ou->bufr) < 0)
+                        { fprintf(stderr,"%s: IO write to file %s/%s.%d.%c failed: %s\n",
+                                         Prog_Name,SORT_PATH,PAIR_NAME,ou->inum,
+                                         bsign ? 'C' : 'N',strerror(errno));
+                          Clean_Exit(1);
+                        }
+                      ou->btop = ou->bufr;
+                    }
+                  else
+                    ou->btop = btop;
+                }
+            }
+        }
+    }
+
+  { int j;
+
+    for (j = 0; j < NPARTS; j++)
+      { if (nunit[j].btop > nunit[j].bufr)
+          if (sj_write_all(nunit[j].file,nunit[j].bufr,nunit[j].btop-nunit[j].bufr) < 0)
+            { fprintf(stderr,"%s: IO write to file %s/%s.%d.N failed: %s\n",
+                             Prog_Name,SORT_PATH,PAIR_NAME,nunit[j].inum,strerror(errno));
               Clean_Exit(1);
             }
         if (cunit[j].btop > cunit[j].bufr)
-          if (write(cunit[j].file,cunit[j].bufr,cunit[j].btop-cunit[j].bufr) < 0)
-            { fprintf(stderr,"%s: IO write to file %s/%s.%d.C failed\n",
-                             Prog_Name,SORT_PATH,PAIR_NAME,cunit[j].inum);
+          if (sj_write_all(cunit[j].file,cunit[j].bufr,cunit[j].btop-cunit[j].bufr) < 0)
+            { fprintf(stderr,"%s: IO write to file %s/%s.%d.C failed: %s\n",
+                             Prog_Name,SORT_PATH,PAIR_NAME,cunit[j].inum,strerror(errno));
               Clean_Exit(1);
             }
       }
   }
 
+  sxgc_union_worker_free(worker);
   parm->nhits = nhits;
   parm->tseed = tseed;
   return (NULL);
 }
