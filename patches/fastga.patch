+//  pthread_create that terminates the program on failure (e.g. thread/memory limits), instead
+//  of later joining or running an uninitialized thread.
+
+static void Spawn(pthread_t *thread, void *(*routine)(void *), void *arg)
+{ int err = pthread_create(thread,NULL,routine,arg);
+  if (err != 0)
+    { fprintf(stderr,"%s: Cannot create thread (error %d)\n",Prog_Name,err);
+      Clean_Exit(1);
+    }
+}
+
+//  Compute budget of the seed search.  While the NTHREADS searchers work, the producer loads,
+//  sorts and cuts the next part with NTHREADS threads of its own, so without a budget up to
+//  2*NTHREADS threads would compute at once.  A thread computes only while it holds one of
+//  NTHREADS tokens.  The part-loading threads (the producer's serial steps, reimport, rmsd_sort
+//  and cut) take theirs first ("hi"), so that the next part is ready before the searchers run
+//  out of tasks; a searcher holds a token while it runs tasks and gives it back when it waits for
+//  work or, after a task, when a part-loading thread waits.  A thread never waits for a token
+//  while it holds Sched.lock.  Outside the search the gate is off and every call is a no-op.
+
+typedef struct
+  { pthread_mutex_t lock;
+    pthread_cond_t  hi, lo;
+    int  free;      //  tokens not held
+    int  hiwait;    //  part-loading threads waiting for a token
+    int  lowait;    //  searchers waiting for a token
+    int  active;    //  tokens held
+    int  peak;      //  maximum of active
+  } Gate;
+
+static Gate SGATE = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, PTHREAD_COND_INITIALIZER,
+                      0, 0, 0, 0, 0 };
+static int  SGATE_ON = 0;    //  set before and cleared after the search threads exist
+
+static void gate_acquire(int hi)
+{ if (!SGATE_ON)
+    return;
+  pthread_mutex_lock(&SGATE.lock);
+  if (hi)
+    { SGATE.hiwait += 1;
+      while (SGATE.free == 0)
+        pthread_cond_wait(&SGATE.hi,&SGATE.lock);
+      SGATE.hiwait -= 1;
+    }
+  else
+    { SGATE.lowait += 1;
+      while (SGATE.free == 0 || SGATE.hiwait > 0)
+        pthread_cond_wait(&SGATE.lo,&SGATE.lock);
+      SGATE.lowait -= 1;
+    }
+  SGATE.free -= 1;
+  if (++SGATE.active > SGATE.peak)
+    SGATE.peak = SGATE.active;
+  if (SGATE.free > 0)              //  a wake-up may have gone to a thread that found no token
+    { if (SGATE.hiwait > 0)
+        pthread_cond_signal(&SGATE.hi);
+      else if (SGATE.lowait > 0)
+        pthread_cond_signal(&SGATE.lo);
+    }
+  pthread_mutex_unlock(&SGATE.lock);
+}
+
+static void gate_release(void)
+{ if (!SGATE_ON)
+    return;
+  pthread_mutex_lock(&SGATE.lock);
+  SGATE.free   += 1;
+  SGATE.active -= 1;
+  if (SGATE.hiwait > 0)
+    pthread_cond_signal(&SGATE.hi);
+  else if (SGATE.lowait > 0)
+    pthread_cond_signal(&SGATE.lo);
+  pthread_mutex_unlock(&SGATE.lock);
+}
+
+static int gate_contended(void)
+{ return (SGATE_ON && __atomic_load_n(&SGATE.hiwait,__ATOMIC_RELAXED) > 0); }
+
+//  rmsd_sort (RSDsort.c) takes a token per sort task through these hooks.
