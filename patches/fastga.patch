+//  Cut the seeds [b,x) of one contig pair into slabs of at least SLAB_MIN seeds, at jumps of two
+//  or more in the diagonal bucket (see above), and add them to the job as separate tasks.
+
+static void cut_unit(Job *job, int *nmax, uint8 *b, uint8 *x, int ctg1, int ctg2, int swide)
+{ int64   band, pband;
+  uint8  *_band = (uint8 *) (&band);
+  uint8  *s0, *r;
+  int     nslab, ns;
+  Group  *grp;
+  Unit   *w;
+
+  //  pass 1: count the slabs
+
+  nslab = 0;
+  band  = 0;
+  s0    = b;
+  memcpy(_band,b+(DBYTE+2),DBYTE);
+  pband = band;
+  for (r = b+swide; r < x; r += swide)
+    { memcpy(_band,r+(DBYTE+2),DBYTE);
+      if (band > pband+1 && (r-s0)/swide >= SLAB_MIN)
+        { nslab += 1;
+          s0 = r;
+        }
+      pband = band;
+    }
+  nslab += 1;
+
+  grp = (Group *) Malloc(sizeof(Group),"Slab group");
+  if (grp == NULL)
+    Clean_Exit(1);
+  grp->gat = (Gather *) Malloc(sizeof(Gather)*nslab,"Slab gathers");
+  if (grp->gat == NULL)
+    Clean_Exit(1);
+  memset(grp->gat,0,sizeof(Gather)*nslab);
+  grp->nslab = nslab;
+  grp->ndone = 0;
+
+  //  pass 2: emit them
+
+  grow_units(job,nmax,nslab);
+  ns   = 0;
+  band = 0;
+  s0   = b;
+  memcpy(_band,b+(DBYTE+2),DBYTE);
+  pband = band;
+  for (r = b+swide; r <= x; r += swide)
+    { int cut;
+
+      if (r < x)
+        { memcpy(_band,r+(DBYTE+2),DBYTE);
+          cut = (band > pband+1 && (r-s0)/swide >= SLAB_MIN);
+        }
+      else
+        cut = 1;
+      if (cut)
+        { w = job->unit + job->nunit++;
+          w->beg   = s0;
+          w->end   = r;
+          w->ctg1  = ctg1;
+          w->ctg2  = ctg2;
+          w->nseed = (r-s0)/swide;
+          w->grp   = grp;
+          w->slab  = ns++;
+          s0 = r;
+        }
+      pband = band;
+    }
+  if (ns != nslab)
+    { fprintf(stderr,"%s: Slab count mismatch\n",Prog_Name);
+      Clean_Exit(1);
+    }
+}
+
+//  Cutting a sorted part into units reads every seed once (twice for the seeds of a unit that is
+//  cut into slabs), which would keep all searchers waiting for a long time if done by one thread
+//  (about 20 s for a part of 10^9 seeds).  The seeds of each A contig are therefore divided into
+//  pieces of PIECE_SEEDS seeds, whose ends are moved forward to the next change of B contig, and
+//  the pieces are cut by all threads.  Unit boundaries are the same as in a single scan.
+
+#ifndef PIECE_SEEDS
+#define PIECE_SEEDS  (1ll<<21)
+#endif
+
+typedef struct
+  { uint8 *cbeg, *cend;   //  seeds of the A contig the piece lies in
+    uint8 *lo, *hi;       //  nominal range
+    int    ctg1;
+    Job    out;           //  units found (unit array only)
+    int    nmax;
+  } Piece;
+
+typedef struct
+  { pthread_mutex_t lock;
+    Piece *piece;
+    int    npiece;
+    int    next;
+    int    swide;
+  } CutArg;
+
+static void *cut_thread(void *args)
+{ CutArg *ca    = (CutArg *) args;
+  int     swide = ca->swide;
+  int     foffs = swide-JCONT;
+  int64   jcrnt;
+  uint8  *_jcrnt = (uint8 *) (&jcrnt);
+
+  while (1)
+    { Piece *pc;
+      uint8 *lo, *hi, *x, *b;
+
+      pthread_mutex_lock(&ca->lock);
+      if (ca->next >= ca->npiece)
+        { pthread_mutex_unlock(&ca->lock);
+          break;
+        }
+      pc = ca->piece + ca->next++;
+      pthread_mutex_unlock(&ca->lock);
+
+      lo = pc->lo;
+      hi = pc->hi;
+      if (lo > pc->cbeg)
+        while (lo < pc->cend && memcmp(lo+foffs,lo-swide+foffs,JCONT) == 0)
+          lo += swide;
+      if (hi < pc->cend)
+        while (hi < pc->cend && memcmp(hi+foffs,hi-swide+foffs,JCONT) == 0)
+          hi += swide;
+      pc->out.unit  = NULL;
+      pc->out.nunit = 0;
+      pc->nmax      = 0;
+      if (lo >= hi)
+        continue;
+
+      jcrnt = 0;
+      memcpy(_jcrnt,lo+foffs,JCONT);
+      b = lo;
+      for (x = lo+swide; x <= hi; x += swide)
+        if (x == hi || memcmp(_jcrnt,x+foffs,JCONT))
+          { Unit *w;
+
+            if (pc->out.nunit >= pc->nmax)
+              grow_units(&(pc->out),&(pc->nmax),1);
+            if ((x-b)/swide > SLAB_SPLIT)
+              cut_unit(&(pc->out),&(pc->nmax),b,x,pc->ctg1,(int) jcrnt,swide);
+            else
+              { w = pc->out.unit + pc->out.nunit++;
+                w->beg   = b;
+                w->end   = x;
+                w->ctg1  = pc->ctg1;
+                w->ctg2  = (int) jcrnt;
+                w->nseed = (x-b)/swide;
+                w->grp   = NULL;
+                w->slab  = 0;
+              }
+            if (x == hi)
+              break;
+            memcpy(_jcrnt,x+foffs,JCONT);
+            b = x;
+          }
+    }
+  return (NULL);
+}
+
+static void *cut_gated(void *args)
+{ gate_acquire(1);
+  cut_thread(args);
+  gate_release();
+  return (NULL);
+}
+
+static void cut_part(Job *job, uint8 *sarray, int64 *panel, int c0, int c1, int swide)
+{ CutArg     ca;
+  Piece     *pc;
+  int        np, cap, c, k, total;
+  uint8     *x;
+  pthread_t *threads;
+
+  cap = 64;
+  np  = 0;
+  pc  = (Piece *) Malloc(sizeof(Piece)*cap,"Cut pieces");
+  if (pc == NULL)
+    Clean_Exit(1);
+  x = sarray;
+  for (c = c0; c < c1; c++)
+    { int64 n = panel[c]/swide;
+      int64 m = (n + PIECE_SEEDS-1)/PIECE_SEEDS;
+
+      if (n == 0)
+        continue;
+      if (np + m > cap)
+        { cap = 2*cap + m;
+          pc = (Piece *) realloc(pc,sizeof(Piece)*cap);
+          if (pc == NULL)
+            { fprintf(stderr,"%s: Out of memory for cut pieces\n",Prog_Name);
+              Clean_Exit(1);
+            }
+        }
+      for (k = 0; k < m; k++)
+        { Piece *w = pc + np++;
+
+          w->cbeg = x;
+          w->cend = x + panel[c];
+          w->lo   = x + k*PIECE_SEEDS*swide;
+          w->hi   = (k+1 == m) ? x + panel[c] : x + (k+1)*PIECE_SEEDS*swide;
+          w->ctg1 = c;
+        }
+      x += panel[c];
+    }
+
+  pthread_mutex_init(&ca.lock,NULL);
+  ca.piece  = pc;
+  ca.npiece = np;
+  ca.next   = 0;
+  ca.swide  = swide;
+  threads = (pthread_t *) Malloc(sizeof(pthread_t)*NTHREADS,"Cut threads");
+  if (threads == NULL)
+    Clean_Exit(1);
+  gate_release();                          //  the caller's token: each cut thread takes its own
+  for (k = 1; k < NTHREADS; k++)
+    Spawn(threads+k,cut_gated,&ca);
+  cut_gated(&ca);
+  for (k = 1; k < NTHREADS; k++)
+    pthread_join(threads[k],NULL);
+  gate_acquire(1);
+  free(threads);
+  pthread_mutex_destroy(&ca.lock);
+
+  total = 0;
+  for (k = 0; k < np; k++)
+    total += pc[k].out.nunit;
+  job->unit  = (Unit *) Malloc(sizeof(Unit)*(total+1),"Search units");
+  if (job->unit == NULL)
+    Clean_Exit(1);
+  job->nunit = 0;
+  for (k = 0; k < np; k++)
+    { if (pc[k].out.nunit > 0)
+        memcpy(job->unit+job->nunit,pc[k].out.unit,sizeof(Unit)*pc[k].out.nunit);
+      job->nunit += pc[k].out.nunit;
+      free(pc[k].out.unit);
+    }
+  free(pc);
+}
