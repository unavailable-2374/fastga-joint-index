+    int     ready;
+    int     armed;      //  tail filled: decode chunks may be claimed
+    int     nchunk;     //  decode work: chunks [0,nchunk) of chunk bases
+    int     nextc;      //  next chunk to claim (atomic)
+    int     donec;      //  chunks decoded (atomic)
+    int64   chunk;
+    int64   len;
+    int64   stamp;
