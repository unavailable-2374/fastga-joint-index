+static void grow_units(Job *job, int *nmax, int more)
+{ if (job->nunit + more > *nmax)
+    { *nmax = 2*(*nmax) + more + 256;
+      job->unit = (Unit *) realloc(job->unit,sizeof(Unit)*(*nmax));
+      if (job->unit == NULL)
+        { fprintf(stderr,"%s: Out of memory for search units\n",Prog_Name);
+          Clean_Exit(1);
+        }
+    }
