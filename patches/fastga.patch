+  //  Write all n bytes to fd, retrying after EINTR and short writes.  Returns n, or -1 with
+  //    errno set if the data could not be written (a write that makes no progress is ENOSPC).
+
+static inline int64_t sj_write_all(int fd, const void *buf, int64_t n)
+{ const char *p = (const char *) buf;
+  int64_t     left = n;
+
+  while (left > 0)
+    { ssize_t w = write(fd,p,(size_t) (left > 0x70000000 ? 0x70000000 : left));
+      if (w < 0)
+        { if (errno == EINTR)
+            continue;
+          return (-1);
+        }
+      if (w == 0)
+        { errno = ENOSPC;
+          return (-1);
+        }
+      p    += w;
+      left -= w;
+    }
+  return (n);
+}
