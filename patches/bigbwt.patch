+  while(towrite>0) {
+    long written = pwrite(fd,b+c,towrite,start);
+    if(written<0) { if(errno==EINTR) continue; die("pwrite error (1)"); }
+    if(written>towrite) die("pwrite error (2)");
+    towrite -= written;
+    start += written;
+    c += written;
+  }
