+// sequential write of the SA stream (the target can be a pipe)
+static void fd_write_stream(int fd, const uint8_t *b, size_t towrite)
+{
+  while(towrite>0) {
+    ssize_t written = write(fd,b,towrite);
+    if(written<0) { if(errno==EINTR) continue; die("SA stream write error (1)"); }
+    if(written==0 || (size_t) written>towrite) die("SA stream write error (2)");
+    towrite -= written;
+    b += written;
+  }
+}
+
+// per-thread output of one range: BWT chars and SA values, flushed in chunks
+struct Emitter {
+  thread_data *d;
+  range_state *rs;
+  long id;
+  uint8_t *bwt, *sab;    // chunk buffers, Stream_chunk_entries entries each
+  long nb, ns, produced; // entries in the buffers, entries of the range so far
+  long bwt_off;          // BWT chars already written for this range
+  bool skip_first;       // the very first BWT char has no SA value
+  explicit Emitter(thread_data *td) : d(td), rs(NULL), id(0), nb(0), ns(0), produced(0), bwt_off(0), skip_first(false) {
+    bwt = (uint8_t *) malloc(Stream_chunk_entries);
+    sab = (uint8_t *) malloc((size_t) Stream_chunk_entries*SABYTES);
+    if(bwt==NULL || sab==NULL) die("malloc failed (chunk buffers)");
+  }
+  ~Emitter() { free(bwt); free(sab); }
+  void begin(range_state *r, long i) {
+    rs = r; id = i; nb = ns = produced = bwt_off = 0;
+    skip_first = d->SA && r->r.bwt_start==0;
+  }
+  inline void put(uint8_t b, uint64_t sa) {
+    bwt[nb++] = b;
+    if(d->SA) {
+      if(skip_first) skip_first = false;
+      else { memcpy(sab + ns*SABYTES,&sa,SABYTES); ns++; }
+    }
+    produced++;
+    if(nb==Stream_chunk_entries) flush();
+  }
+  void flush() {
+    if(nb>0) {
+      fd_write(d->bwt_fd,bwt,nb,rs->r.bwt_start + bwt_off);
+      bwt_off += nb; nb = 0;
+    }
+    if(ns>0) {
+      size_t bytes = ns*SABYTES;
+      uint8_t *copy = (uint8_t *) malloc(bytes);
+      if(copy==NULL) die("malloc failed (SA chunk)");
+      memcpy(copy,sab,bytes); ns = 0;
+      double t0 = now_s();
+      std::unique_lock<std::mutex> lk(d->m);
+      d->cv_budget.wait(lk,[&]{ return d->used + bytes <= d->budget ||
+                                       (id==d->head && rs->queued < 2*d->chunk_bytes); });
+      d->wait_budget_s += now_s() - t0;
+      d->used += bytes; rs->queued += bytes;
+      if(d->used > d->peak_used) d->peak_used = d->used;
+      rs->chunks.push_back({copy,bytes});
+      lk.unlock();
+      d->cv_writer.notify_all();
+    }
+  }
+  void finish() {
+    flush();
+    assert(produced==rs->r.count);
+    {
+      std::lock_guard<std::mutex> lk(d->m);
+      rs->done = true;
+    }
+    d->cv_writer.notify_all();
+  }
+};
